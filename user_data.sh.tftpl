#!/bin/bash
set -euo pipefail

# ---------- System setup ----------
sysctl -w vm.max_map_count=262144
echo "vm.max_map_count=262144" >> /etc/sysctl.conf

# ---------- Install Docker ----------
dnf install -y docker jq
systemctl enable docker
systemctl start docker

# Install docker-compose plugin (pinned version, verified against its SHA-256)
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/${docker_compose_version}/docker-compose-linux-x86_64" \
  -o /tmp/docker-compose
echo "${docker_compose_sha256}  /tmp/docker-compose" | sha256sum -c -
install -m 0755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
rm -f /tmp/docker-compose

# ---------- Create app directory ----------
mkdir -p /opt/nullafi
cd /opt/nullafi
umask 077

# ---------- Read secrets from Secrets Manager ----------
# secrets_version=${secrets_version} (bumping it replaces the instance so new values are read)
# Retries cover IAM propagation of the freshly created instance role.
get_secret() {
  local arn="$1" region
  region=$(cut -d: -f4 <<<"$arn")
  for attempt in $(seq 1 30); do
    if aws secretsmanager get-secret-value --region "$region" --secret-id "$arn" --query SecretString --output text; then
      return 0
    fi
    echo "Secret not readable yet (attempt $attempt/30), retrying in 10s" >&2
    sleep 10
  done
  return 1
}

PROXY_CA_JSON=$(get_secret "${proxy_ca_secret_arn}")
jq -er '.cert' <<<"$PROXY_CA_JSON" > /opt/nullafi/mitm.crt
jq -er '.key' <<<"$PROXY_CA_JSON" > /opt/nullafi/mitm.key
unset PROXY_CA_JSON
chmod 644 /opt/nullafi/mitm.crt
chmod 600 /opt/nullafi/mitm.key

LICENSE_KEY=$(get_secret "${license_key_secret_arn}")
ELASTIC_PASSWORD=$(openssl rand -hex 24)
get_secret "${acme_dns01_env_secret_arn}" | jq -r 'to_entries[] | "\(.key)=\(.value)"' > /opt/nullafi/acme-dns01.env

# ---------- Write .env ----------
cat > .env <<'ENVEOF'
HOST_NAME=${host_name}
SHIELD_IMAGE=${shield_image}
SQUID_IMAGE=${squid_image}
ELASTIC_IMAGE=${activity_image}
REDIS_IMAGE=${redis_image}
PROXY_PORT=${proxy_port}
RESTART_POLICY=unless-stopped
NULLAFI_HTTPS_ENABLED=${has_domain ? "true" : "false"}
ENVEOF
printf 'ELASTIC_PASSWORD=%s\n' "$ELASTIC_PASSWORD" >> .env
printf 'NULLAFI_LICENSE_KEY=%s\n' "$LICENSE_KEY" >> .env
unset ELASTIC_PASSWORD LICENSE_KEY

# ---------- Write docker-compose.yml ----------
cat > docker-compose.yml <<'COMPOSEEOF'
networks:
  shield_net:
    name: shield_net
    driver: bridge

volumes:
  activity:
  redis:
  certs:

x-add-logging: &add-logging
  logging:
    driver: json-file
    options:
      max-size: "10m"
      max-file: "2"

services:
  shield-web-ui:
    <<: *add-logging
    image: "$${SHIELD_IMAGE}"
    container_name: shield-web-ui
    hostname: shield-web-ui
    restart: "$${RESTART_POLICY}"
    networks:
      shield_net:
        aliases:
          - "$${HOST_NAME}"
    ports:
      - "80:8080"
      - "443:443"
    volumes:
      - "certs:/apps/nullafi/user-data/certs"
    env_file:
      - /opt/nullafi/acme-dns01.env
    environment:
      NULLAFI_HTTP_CUSTOM_DOMAIN: "$${HOST_NAME}"
      NULLAFI_ACTIVITY_DATABASE_URL: "http://elastic:$${ELASTIC_PASSWORD}@activity:9200"
      NULLAFI_REDIS_URI: "redis://redis:6379/0"
      NULLAFI_SERVERMODE: "web"
      NULLAFI_HTTPS_ENABLED: "$${NULLAFI_HTTPS_ENABLED:-false}"
      NULLAFI_HTTPS_PORT: 443
      NULLAFI_HTTPS_ACME_CHALLENGE: "${acme_challenge_type}"
      NULLAFI_HTTPS_ACME_CERT_DIR: "/apps/nullafi/user-data/certs"
%{ if acme_dns01_provider != null ~}
      NULLAFI_HTTPS_ACME_DNS01_PROVIDER: "${acme_dns01_provider}"
%{ endif ~}
%{ if route53_zone_id != null ~}
      AWS_HOSTED_ZONE_ID: "${route53_zone_id}"
      AWS_REGION: "${region}"
%{ endif ~}
      NULLAFI_LICENSE_KEY_VALUE: "$${NULLAFI_LICENSE_KEY:-}"

  shield-icap:
    <<: *add-logging
    image: "$${SHIELD_IMAGE}"
    container_name: shield-icap
    hostname: shield-icap
    restart: "$${RESTART_POLICY}"
    networks:
      - shield_net
    depends_on:
      - shield-web-ui
    mem_limit: 1g
    environment:
      NULLAFI_HTTP_CUSTOM_DOMAIN: "$${HOST_NAME}"
      NULLAFI_ACTIVITY_DATABASE_URL: "http://elastic:$${ELASTIC_PASSWORD}@activity:9200"
      NULLAFI_REDIS_URI: "redis://redis:6379/0"
      NULLAFI_SERVERMODE: "icap"
      NULLAFI_NODE_NAME: "Policy 1"
      NULLAFI_LICENSE_KEY_VALUE: "$${NULLAFI_LICENSE_KEY:-}"

  shield-alert:
    <<: *add-logging
    image: "$${SHIELD_IMAGE}"
    container_name: shield-alert
    hostname: shield-alert
    restart: "$${RESTART_POLICY}"
    networks:
      - shield_net
    environment:
      NULLAFI_HTTP_CUSTOM_DOMAIN: "$${HOST_NAME}"
      NULLAFI_ACTIVITY_DATABASE_URL: "http://elastic:$${ELASTIC_PASSWORD}@activity:9200"
      NULLAFI_REDIS_URI: "redis://redis:6379/0"
      NULLAFI_SERVERMODE: "alert"
      NULLAFI_LICENSE_KEY_VALUE: "$${NULLAFI_LICENSE_KEY:-}"

  squid:
    <<: *add-logging
    image: "$${SQUID_IMAGE}"
    container_name: squid
    hostname: squid
    restart: "$${RESTART_POLICY}"
    networks:
      - shield_net
    mem_limit: 400m
    ports:
      - "$${PROXY_PORT}:44509"
    volumes:
      - "/opt/nullafi/mitm.crt:/etc/squid6/custom.crt:ro"
      - "/opt/nullafi/mitm.key:/etc/squid6/custom.pem:ro"
    environment:
      BYPASS_URLS: "/etc/squid6/urls.txt"
      MITM_CERT: "/etc/squid6/custom.crt"
      MITM_KEY: "/etc/squid6/custom.pem"
      ICAP_URL: "icap://shield-icap:1344"
      ENABLE_ICAP: "yes"
      MITM_PROXY: "yes"

  activity:
    <<: *add-logging
    image: "$${ELASTIC_IMAGE}"
    container_name: activity
    hostname: activity
    restart: "$${RESTART_POLICY}"
    networks:
      - shield_net
    mem_limit: 2g
    ulimits:
      memlock:
        soft: -1
        hard: -1
    volumes:
      - "activity:/usr/share/elasticsearch/data"
    environment:
      - node.name=es01
      - cluster.name=activity
      - cluster.initial_master_nodes=es01
      - ELASTIC_PASSWORD=$${ELASTIC_PASSWORD}
      - bootstrap.memory_lock=true
      - xpack.security.enabled=false

  redis:
    <<: *add-logging
    image: "$${REDIS_IMAGE}"
    container_name: redis
    hostname: redis
    restart: "$${RESTART_POLICY}"
    networks:
      - shield_net
    command: redis-server --save 20 1 --loglevel warning
    mem_limit: 300m
    volumes:
      - "redis:/data"
COMPOSEEOF

# ---------- Wait for DNS to resolve to this instance's EIP ----------
%{ if has_domain ~}
EIP=$(curl -s --max-time 5 http://169.254.169.254/latest/meta-data/public-ipv4 -H "X-aws-ec2-metadata-token: $(curl -s --max-time 5 -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')")
echo "Waiting for ${host_name} to resolve to $EIP ..."
for i in $(seq 1 ${dns_wait_iterations}); do
  RESOLVED=$(dig +short ${host_name} @8.8.8.8 | head -1)
  if [ "$RESOLVED" = "$EIP" ]; then
    echo "DNS resolved after $((i * 10))s"
    break
  fi
  sleep 10
done
%{ endif ~}

# ---------- Start the stack ----------
docker compose up -d
